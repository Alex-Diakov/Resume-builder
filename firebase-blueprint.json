{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and profile configuration",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "tier": { "type": "string", "enum": ["free", "pro"] }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "ResumeDocument": {
      "title": "ResumeDocument",
      "description": "User resume document with customized data and styling",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 128 },
        "targetRole": { "type": "string", "maxLength": 128 },
        "data": { "type": "object" },
        "layoutSettings": { "type": "object" },
        "styleSettings": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "data", "createdAt", "updatedAt"]
    },
    "ExportTelemetry": {
      "title": "ExportTelemetry",
      "description": "Telemetry record of a generated export document (PDF, Word, Print)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "resumeId": { "type": "string", "maxLength": 128 },
        "resumeTitle": { "type": "string", "maxLength": 128 },
        "format": { "type": "string", "enum": ["pdf", "docx", "print"] },
        "timestamp": { "type": "string", "maxLength": 64 },
        "dateStr": { "type": "string", "maxLength": 32 }
      },
      "required": ["id", "userId", "format", "timestamp", "dateStr"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document containing core account data"
    },
    "/users/{userId}/resumes/{resumeId}": {
      "schema": "ResumeDocument",
      "description": "User's customized resumes in their personal library"
    },
    "/users/{userId}/exports/{exportId}": {
      "schema": "ExportTelemetry",
      "description": "Log of exports performed by this authenticated user"
    }
  }
}
